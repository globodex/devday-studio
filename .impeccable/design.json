  "narrative": {
    "northStar": "Los assets digitales DevDay en el centro",
    "overview": "La identidad procede de los assets digitales DDE y las referencias de speakers suministradas. OpenAI Sans, los agentes circulares con expresiones y los colores saturados pertenecen a las piezas; el entorno de edición usa blancos y verdes suaves para mantener legibles los controles.\n\nLa densidad es compacta y la jerarquía depende de la tipografía, la separación y los estados seleccionados. Las superficies de formulario son planas; el lienzo tiene la profundidad necesaria para distinguir la pieza de su entorno.",
    "keyCharacteristics": [
      "OpenAI Sans local y wordmark propio.",
      "Entorno claro, acciones verdes y piezas con tema claro u oscuro.",
      "Agentes circulares expresivos como firma visual.",
      "Controles compactos, selección visible y foco de teclado.",
      "Composiciones propias para cuatro relaciones de aspecto."
    ],
    "rules": [
      {
        "name": "The Editorial Contrast Rule",
        "body": "El titular editorial pasa por readableAccent: conserva el acento cuando alcanza 3:1 contra el fondo y, si no, acerca sus canales RGB al negro o al blanco hasta alcanzar ese contraste. El umbral corresponde a ese titular grande; no es una garantía general para textos pequeños ni se aplica automáticamente a insignias, agentes o fotografías.",
        "section": "colors"
      },
      {
        "name": "The Shared Typography Rule",
        "body": "Vista previa y exportaciones usan las mismas fuentes locales y el mismo renderizador; las dimensiones tipográficas de la pieza se expresan en coordenadas del formato de salida, no en píxeles CSS de la vista previa.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do mantener las fuentes locales y los assets digitales como autoridad visual.",
      "Do separar el verde de acción de los acentos saturados de las piezas.",
      "Do conservar el foco visible, la selección explícita y el color final de los textos de ayuda.",
      "Do comprobar cada composición en su propio formato y conservar la vista previa antes del formulario en móvil.",
      "Do usar readableAccent para el titular editorial y el mismo renderizador para vista previa y descarga."
    ],
    "donts": [
      "Don't sustituir las composiciones digitales por las de impresión.",
      "Don't recortar el formato cuadrado para simular historia, retrato u horizontal.",
      "Don't atribuir el ajuste de contraste editorial a todos los elementos del lienzo.",
      "Don't añadir navegación ficticia ni controles que no tengan una acción.",
      "Don't activar automáticamente la reproducción cuando el navegador solicita movimiento reducido."
    ]
  }
